# WK2026 Predictor Environment Configuration
# Copy this file to .env and fill in your API keys for live data

# The Odds API - https://the-odds-api.com
# Sign up for free tier (500 requests/month)
ODDS_API_KEY=your_odds_api_key_here

# RapidAPI - for API-Football
# https://rapidapi.com/api-sports/api/api-football
RAPIDAPI_KEY=your_rapidapi_key_here

# Optional: Anthropic API for injury news (Claude fallback)
# https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_key_here
